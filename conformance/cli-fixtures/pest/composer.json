{
  "name": "affected/pest-fixture-root",
  "repositories": [
    {
      "type": "path",
      "url": "packages/*",
      "options": {
        "symlink": true
      }
    }
  ],
  "require-dev": {
    "pestphp/pest": "5.3.0",
    "affected/fixture-pest-alpha": "1.0.0",
    "affected/fixture-pest-beta": "1.0.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
