/*/build/
/.gradle/
/*/.gradle/
/.idea/
/.kotlin/
/*/.kotlin/
/.intellijPlatform/
/*/.intellijPlatform/
*.iml
/local.properties
/fixtures/
/docs/superpowers/
/conformance/cli-fixtures/dotnet/**/bin/
/conformance/cli-fixtures/dotnet/**/obj/
/conformance/cli-fixtures/ant/build/
/conformance/cli-fixtures/ant/affected-alpha.marker
/conformance/cli-fixtures/kotlin-toolchain/build/
/conformance/cli-fixtures/bazel/bazel-*
/conformance/cli-fixtures/bazel/MODULE.bazel.lock
/conformance/cli-fixtures/kotlin-toolchain-multi/build/
/conformance/cli-fixtures/kotlin-toolchain-multi/app/build/
/conformance/cli-fixtures/kotlin-toolchain-multi/lib/build/
/core/src/main/dotnet/**/bin/
/core/src/main/dotnet/**/obj/
