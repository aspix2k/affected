<idea-plugin>
    <id>com.aspix2k.affected</id>
    <name>Affected</name>
    <vendor url="https://github.com/aspix2k/affected">aspix</vendor>

    <description><![CDATA[
        <p><b>A JetBrains IDE plugin that finds affected projects and runs only their tests and build checks.</b></p>
        <p>
            Built for multi-module projects and monorepos across JVM, Android,
            Rust, Go, Node.js, .NET, Python, PHP, Ruby and C/C++.
        </p>
        <p><b>What you get</b></p>
        <ul>
            <li>Run supported JVM, Android, Rust, Go, Node.js, .NET, Python, PHP,
                Ruby and C/C++ projects from one action.</li>
            <li>Keep all commands for one build-system root in one Run session.</li>
            <li>Narrow compatible Gradle and Maven modules to affected JUnit test classes,
                and supported Jest or Vitest packages to related test files.</li>
            <li>Optionally verify direct dependents after a public API change.</li>
            <li>No account, server, telemetry or project-specific configuration file.</li>
        </ul>
        <p><b>Supported projects</b></p>
        <ul>
            <li><b>Kotlin, Java and Android:</b> Gradle and Maven.</li>
            <li><b>Rust and Go:</b> Cargo workspaces and packages; Go modules.</li>
            <li><b>JavaScript and TypeScript:</b> npm, Yarn and pnpm packages with Jest or Vitest.</li>
            <li><b>C#, F# and Visual Basic:</b> .NET solutions and projects.</li>
            <li><b>Python:</b> pytest and mypy projects.</li>
            <li><b>PHP:</b> Composer packages with PHPUnit or PHPStan.</li>
            <li><b>Ruby:</b> Bundler projects with RSpec.</li>
            <li><b>C and C++:</b> CMake projects with build targets and CTest.</li>
        </ul>
        <p>
            Works in IntelliJ IDEA, Android Studio, Rider, GoLand, CLion, PyCharm,
            WebStorm, PhpStorm, RubyMine, RustRover and DataSpell based on IntelliJ
            Platform 2025.3 or newer.
        </p>
        <p><b>Install Affected, open a supported project and choose Run affected tests.</b></p>
        <p>
            <a href="https://github.com/aspix2k/affected">Documentation</a> ·
            <a href="https://github.com/aspix2k/affected/issues">Issue tracker</a> ·
            <a href="https://github.com/aspix2k/affected/blob/main/PRIVACY.md">Privacy</a>
        </p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="affected-gradle.xml">com.intellij.gradle</depends>
    <depends optional="true" config-file="affected-maven.xml">org.jetbrains.idea.maven</depends>

    <resource-bundle>messages.AffectedBundle</resource-bundle>

    <content>
        <module name="affected.mcp" loading="optional"/>
    </content>

    <extensionPoints>
        <extensionPoint name="buildSystem" interface="com.aspix2k.affected.build.BuildSystem" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.aspix2k.affected">
        <buildSystem implementation="com.aspix2k.affected.build.CargoBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.GoBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.NodeBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.DotnetBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.PythonBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.ComposerBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.RubyBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.CMakeBuildSystem"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="AffectedTests" displayType="BALLOON" bundle="messages.AffectedBundle"
                           key="group.title"/>
        <postStartupActivity implementation="com.aspix2k.affected.StartupRefresh"/>
        <checkinHandlerFactory implementation="com.aspix2k.affected.AffectedCheckinHandlerFactory"/>
        <errorHandler implementation="com.aspix2k.affected.AffectedErrorReportSubmitter"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <vcs.prePushHandler implementation="com.aspix2k.affected.AffectedPrePushHandler"/>
    </extensions>

    <applicationListeners>
        <listener class="com.aspix2k.affected.ChangeListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </applicationListeners>

    <actions>
        <group id="com.aspix2k.affected.Group"
               class="com.aspix2k.affected.AffectedGroup"
               popup="true">
            <add-to-group group-id="MainToolbarRight" anchor="before" relative-to-action="NewUiRunWidget"/>
            <add-to-group group-id="RunMenu" anchor="first"/>

            <action id="com.aspix2k.affected.Run"
                    class="com.aspix2k.affected.RunAffectedTestsAction"
                    icon="AllIcons.Actions.Execute">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt shift T"/>
            </action>
            <action id="com.aspix2k.affected.Detekt"
                    class="com.aspix2k.affected.RunDetektAction"/>
            <action id="com.aspix2k.affected.Lint"
                    class="com.aspix2k.affected.RunLintAction"/>
            <action id="com.aspix2k.affected.Coverage"
                    class="com.aspix2k.affected.RunCoverageAction"/>
            <separator/>
            <group id="com.aspix2k.affected.Modules"
                   class="com.aspix2k.affected.AffectedModulesGroup"
                   popup="true"/>
            <separator/>
            <group id="com.aspix2k.affected.Settings"
                   popup="true">
                <action id="com.aspix2k.affected.CheckConsumers"
                        class="com.aspix2k.affected.CheckConsumersToggle"/>
                <separator/>
                <action id="com.aspix2k.affected.RunBeforeCommit"
                        class="com.aspix2k.affected.RunBeforeCommitToggle"/>
                <action id="com.aspix2k.affected.RunBeforePush"
                        class="com.aspix2k.affected.RunBeforePushToggle"/>
                <separator/>
                <action id="com.aspix2k.affected.AnimateWhileRunning"
                        class="com.aspix2k.affected.AnimateWhileRunningToggle"/>
            </group>
        </group>
    </actions>
</idea-plugin>
