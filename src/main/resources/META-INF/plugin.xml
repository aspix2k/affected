<idea-plugin>
    <id>com.aspix2k.affected</id>
    <name>Affected</name>
    <vendor url="https://github.com/aspix2k/affected">aspix</vendor>

    <description><![CDATA[
        <p><b>A JetBrains IDE plugin that finds affected projects and runs only their tests and build checks.</b></p>
<!-- affected-support-summary:start -->
        <p>Built for multi-module projects and monorepos across 28 supported build ecosystems and 11 JetBrains products.</p>
        <p><a href="https://github.com/aspix2k/affected/blob/main/docs/SUPPORT.md">Support matrix</a>: languages, test runners, selection units and evidence.</p>
<!-- affected-support-summary:end -->
        <p><b>What you get</b></p>
        <ul>
            <li>Run supported ecosystems from one action.</li>
            <li>Keep all commands for one build-system root in one Run session.</li>
            <li>Narrow to the smallest unit proven by the native build system or test runner.</li>
            <li>Optionally compile direct dependents after a public API change, or run the tests of every module that depends on the change.</li>
            <li>Optionally run the plan before a commit or push.</li>
            <li>After a failure, check the base branch to tell a regression from a test that was already failing (Gradle, Maven, Go and Cargo).</li>
            <li>Diagnose explains what was detected and why nothing ran; one settings page holds every switch.</li>
            <li>No account, server, telemetry or project-specific configuration file.</li>
            <li>Optional JetBrains MCP Server tools use the same analysis snapshot and run lease.</li>
        </ul>
        <p><b>Install Affected, open a supported project and choose Run affected tests.</b></p>
        <p>
            <a href="https://github.com/aspix2k/affected">Documentation</a> ·
            <a href="https://github.com/aspix2k/affected/issues">Issue tracker</a> ·
            <a href="https://github.com/aspix2k/affected/blob/main/docs/PRIVACY.md">Privacy</a>
        </p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="affected-git.xml">Git4Idea</depends>
    <depends optional="true" config-file="affected-gradle.xml">com.intellij.gradle</depends>
    <depends optional="true" config-file="affected-maven.xml">org.jetbrains.idea.maven</depends>

    <resource-bundle>messages.AffectedBundle</resource-bundle>

    <content>
        <module name="affected.mcp" loading="optional"/>
    </content>

    <extensionPoints>
        <extensionPoint name="buildSystem" interface="com.aspix2k.affected.build.BuildSystem" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.aspix2k.affected">
        <buildSystem implementation="com.aspix2k.affected.build.IdeCargoBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeGoBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeNodeBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeDotnetBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdePythonBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeComposerBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeRubyBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeRBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeCMakeBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeSbtBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeAntBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeKotlinToolchainBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeBazelBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeDartBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeFlutterBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeMesonBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeMakeBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeNinjaBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdePantsBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeBuck2BuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeSwiftBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeXcodeBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeDbtBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeSqlcBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeAtlasBuildSystem"/>
        <buildSystem implementation="com.aspix2k.affected.build.IdeDenoBuildSystem"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="AffectedTests" displayType="BALLOON" bundle="messages.AffectedBundle"
                           key="group.title"/>
        <externalSystemTaskNotificationListener implementation="com.aspix2k.affected.ExternalSystemRefreshListener"/>
        <postStartupActivity implementation="com.aspix2k.affected.StartupRefresh"/>
        <checkinHandlerFactory implementation="com.aspix2k.affected.AffectedCheckinHandlerFactory"/>
        <errorHandler implementation="com.aspix2k.affected.AffectedErrorReportSubmitter"/>
        <projectConfigurable parentId="tools"
                             id="com.aspix2k.affected.settings"
                             instance="com.aspix2k.affected.AffectedConfigurable"
                             bundle="messages.AffectedBundle"
                             key="settings.display.name"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <vcs.prePushHandler implementation="com.aspix2k.affected.AffectedPrePushHandler"/>
    </extensions>

    <applicationListeners>
        <listener class="com.aspix2k.affected.ChangeListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </applicationListeners>

    <actions>
        <group id="com.aspix2k.affected.Group"
               class="com.aspix2k.affected.AffectedGroup"
               popup="true">
            <add-to-group group-id="MainToolbarRight" anchor="before" relative-to-action="NewUiRunWidget"/>
            <add-to-group group-id="RunMenu" anchor="first"/>

            <action id="com.aspix2k.affected.Run"
                    class="com.aspix2k.affected.RunAffectedTestsAction"
                    icon="AllIcons.Actions.Execute">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt shift T"/>
            </action>
            <action id="com.aspix2k.affected.Detekt"
                    class="com.aspix2k.affected.RunDetektAction"/>
            <action id="com.aspix2k.affected.Lint"
                    class="com.aspix2k.affected.RunLintAction"/>
            <action id="com.aspix2k.affected.Coverage"
                    class="com.aspix2k.affected.RunCoverageAction"/>
            <separator/>
            <group id="com.aspix2k.affected.Modules"
                   class="com.aspix2k.affected.AffectedModulesGroup"
                   popup="true"/>
            <separator/>
            <action id="com.aspix2k.affected.Diagnose"
                    class="com.aspix2k.affected.DiagnoseAction"/>
            <action id="com.aspix2k.affected.AgentSetup"
                    class="com.aspix2k.affected.AgentSetupAction"/>
            <separator/>
            <group id="com.aspix2k.affected.Settings"
                   popup="true">
                <action id="com.aspix2k.affected.OpenSettings"
                        class="com.aspix2k.affected.OpenSettingsAction"/>
                <separator/>
                <action id="com.aspix2k.affected.BaseBranch"
                        class="com.aspix2k.affected.BaseBranchAction"/>
                <action id="com.aspix2k.affected.CheckConsumers"
                        class="com.aspix2k.affected.CheckConsumersToggle"/>
                <action id="com.aspix2k.affected.TestDependents"
                        class="com.aspix2k.affected.TestDependentsToggle"/>
                <separator/>
                <action id="com.aspix2k.affected.RunFullPlan"
                        class="com.aspix2k.affected.RunFullPlanToggle"/>
                <action id="com.aspix2k.affected.StopAfterFirstFailure"
                        class="com.aspix2k.affected.StopAfterFirstFailureToggle"/>
                <separator/>
                <action id="com.aspix2k.affected.RunBeforeCommit"
                        class="com.aspix2k.affected.RunBeforeCommitToggle"/>
                <action id="com.aspix2k.affected.RunBeforePush"
                        class="com.aspix2k.affected.RunBeforePushToggle"/>
                <action id="com.aspix2k.affected.GuardsTestDependents"
                        class="com.aspix2k.affected.GuardsTestDependentsToggle"/>
                <separator/>
                <action id="com.aspix2k.affected.AnimateWhileRunning"
                        class="com.aspix2k.affected.AnimateWhileRunningToggle"/>
            </group>
        </group>
    </actions>
</idea-plugin>
